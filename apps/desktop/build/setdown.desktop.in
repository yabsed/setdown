[Desktop Entry]
Type=Application
Version=1.0
Name=Setdown
GenericName=Files, Markdown Reader, Editor and Web Browser
Comment=Write plain. Read beautifully.
Exec=@APP_DIR@/setdown %U
TryExec=@APP_DIR@/setdown
Icon=setdown
Terminal=false
Categories=Office;TextEditor;Utility;System;FileManager;Network;WebBrowser;
Keywords=Markdown;Editor;Viewer;Writing;Files;Folder;File Manager;Web;Browser;Internet;
MimeType=inode/directory;text/markdown;text/x-markdown;text/plain;application/pdf;application/x-hwp;application/vnd.haansoft-hwp;application/hwp+zip;x-scheme-handler/http;x-scheme-handler/https;
StartupNotify=false
StartupWMClass=Setdown
Actions=files;

[Desktop Action files]
Name=Browse Files
Exec=@APP_DIR@/setdown --files
