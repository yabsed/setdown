{
  "profiles": {
    "pyright": {
      "id": "pyright",
      "name": "Pyright",
      "enabledByDefault": true,
      "languages": [
        {
          "languageId": "python",
          "extensions": [
            ".py",
            ".pyi"
          ]
        }
      ],
      "launch": {
        "kind": "bundledNode",
        "module": "pyright/langserver.index.js",
        "args": [
          "--stdio"
        ]
      },
      "rootMarkers": [],
      "settings": {
        "python": {
          "analysis": {
            "autoSearchPaths": true,
            "useLibraryCodeForTypes": true,
            "diagnosticMode": "openFiles",
            "typeCheckingMode": "basic"
          }
        }
      },
      "watchExtensions": [
        ".py",
        ".pyi",
        ".toml",
        ".json"
      ],
      "watchFiles": []
    },
    "clangd": {
      "id": "clangd",
      "name": "clangd",
      "enabledByDefault": true,
      "automatic": true,
      "languages": [
        {
          "languageId": "c",
          "extensions": [
            ".c",
            ".h"
          ]
        },
        {
          "languageId": "cpp",
          "caseSensitiveExtensions": [
            ".C"
          ],
          "extensions": [
            ".cc",
            ".cpp",
            ".cxx",
            ".c++",
            ".hh",
            ".hpp",
            ".hxx",
            ".h++",
            ".ipp",
            ".inl",
            ".tpp",
            ".ixx",
            ".cppm"
          ]
        }
      ],
      "launch": {
        "kind": "native",
        "command": "clangd",
        "args": [
          "--background-index",
          "--pch-storage=disk",
          "-j=2",
          "--log=error"
        ],
        "environmentVariable": "SETDOWN_CLANGD_PATH",
        "legacySettingsFile": "clangd.json"
      },
      "rootMarkers": [
        ".clangd",
        "compile_commands.json",
        "compile_flags.txt",
        ".git",
        "CMakeLists.txt"
      ],
      "settings": {},
      "watchExtensions": [
        ".c",
        ".h",
        ".cc",
        ".cpp",
        ".cxx",
        ".c++",
        ".hh",
        ".hpp",
        ".hxx",
        ".h++",
        ".ipp",
        ".inl",
        ".tpp",
        ".ixx",
        ".cppm"
      ],
      "watchFiles": [
        ".clangd",
        ".clang-format",
        "compile_commands.json",
        "compile_flags.txt"
      ]
    },
    "gopls": {
      "id": "gopls",
      "name": "gopls",
      "enabledByDefault": true,
      "automatic": true,
      "languages": [
        {
          "languageId": "go",
          "extensions": [
            ".go"
          ]
        }
      ],
      "launch": {
        "kind": "native",
        "command": "gopls",
        "args": []
      },
      "rootMarkers": [
        "go.work",
        "go.mod",
        ".git"
      ],
      "settings": {},
      "watchExtensions": [
        ".go"
      ],
      "watchFiles": [
        "go.mod",
        "go.sum",
        "go.work"
      ]
    },
    "rust-analyzer": {
      "id": "rust-analyzer",
      "name": "rust-analyzer",
      "enabledByDefault": true,
      "automatic": true,
      "languages": [
        {
          "languageId": "rust",
          "extensions": [
            ".rs"
          ]
        }
      ],
      "launch": {
        "kind": "native",
        "command": "rust-analyzer",
        "args": []
      },
      "rootMarkers": [
        "Cargo.toml",
        "rust-project.json",
        ".git"
      ],
      "settings": {},
      "watchExtensions": [
        ".rs",
        ".toml"
      ],
      "watchFiles": [
        "Cargo.lock"
      ]
    },
    "fortls": {
      "id": "fortls",
      "name": "fortls",
      "enabledByDefault": true,
      "automatic": true,
      "discovery": "python",
      "languages": [
        {
          "languageId": "fortran",
          "extensions": [
            ".f",
            ".for",
            ".fpp",
            ".f77",
            ".f90",
            ".f95",
            ".f03",
            ".f08",
            ".f18"
          ]
        }
      ],
      "launch": {
        "kind": "native",
        "command": "fortls",
        "args": [
          "--disable_autoupdate",
          "--hover_signature",
          "--hover_language=fortran",
          "--use_signature_help"
        ]
      },
      "rootMarkers": [
        ".fortlsrc",
        ".fortls.json",
        ".fortls",
        ".git"
      ],
      "settings": {},
      "watchExtensions": [
        ".f",
        ".for",
        ".fpp",
        ".f77",
        ".f90",
        ".f95",
        ".f03",
        ".f08",
        ".f18"
      ],
      "watchFiles": [
        ".fortlsrc",
        ".fortls.json",
        ".fortls"
      ]
    }
  },
  "aliases": {
    "cuelsp": "cuelsp"
  },
  "associations": {
    "pyright": "python",
    "basedpyright": "python",
    "deno": [
      "javascript",
      "typescript",
      "jsx",
      "tsx"
    ],
    "vtsls": [
      "javascript",
      "typescript",
      "jsx",
      "tsx"
    ]
  },
  "monacoIds": {
    "bash": "shell",
    "typescriptreact": "typescript",
    "javascriptreact": "javascript",
    "jsonc": "json",
    "c-sharp": "csharp",
    "f-sharp": "fsharp",
    "ocaml-interface": "ocaml",
    "latex": "latex"
  },
  "manual": {
    "julia": "Install the Julia LanguageServer package before enabling this connection.",
    "r": "Install the R languageserver package before enabling this connection.",
    "racket": "Install racket-langserver before enabling this connection.",
    "cs": "This launcher can download packages. Configure a local stdio connection explicitly.",
    "mojo-lsp-server": "This launcher uses a project environment. Configure a local stdio connection explicitly.",
    "godot": "This profile uses a TCP bridge. Setdown supports stdio connections."
  }
}
