{
  "name": "@setdown/desktop",
  "productName": "Setdown",
  "version": "1.0.0",
  "private": true,
  "author": "Setdown Contributors",
  "homepage": "https://github.com/yabsed/setdown",
  "repository": {
    "type": "git",
    "url": "https://github.com/yabsed/setdown.git",
    "directory": "apps/desktop"
  },
  "description": "A document-first Markdown reader and editor for beautifully typeset local documents",
  "type": "module",
  "main": "dist-electron/main.cjs",
  "scripts": {
    "test:language-servers": "npm run build && bash scripts/with-isolated-display.sh playwright test --config playwright.language-servers.config.ts",
    "test:preview-contract:unit": "vitest run --config vitest.preview-contract.config.ts && node --test scripts/preview-benchmark.test.mjs",
    "test:preview-contract:e2e": "bash scripts/with-isolated-display.sh playwright test --config playwright.preview-contract.config.ts",
    "test:preview-contract": "npm run test:preview-contract:unit && npm run build && npm run test:preview-contract:e2e",
    "bench:preview": "bash scripts/with-isolated-display.sh node scripts/preview-benchmark.mjs",
    "bench:pdf-tabs": "bash scripts/with-isolated-display.sh node scripts/pdf-tab-benchmark.mjs",
    "dev": "npm run build:electron && concurrently -k \"vite --host 127.0.0.1 --port 5173 --strictPort\" \"npm:dev:electron\"",
    "dev:electron": "wait-on http-get://127.0.0.1:5173/ && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .",
    "build:electron": "node scripts/build-electron.mjs",
    "build": "npm run typecheck && vite build && npm run build:electron",
    "typecheck": "tsc --noEmit && tsc --noEmit -p test/tsconfig.json && svelte-check --config ./svelte.config.js --tsconfig ./tsconfig.json --fail-on-warnings",
    "test": "vitest run --config vitest.config.ts",
    "test:e2e": "npm run build && bash scripts/with-isolated-display.sh playwright test",
    "start": "npm run build && electron .",
    "package:win": "npm run build && electron-builder --win nsis --x64",
    "package:linux": "npm run build && electron-builder --linux AppImage deb rpm",
    "install:linux": "bash scripts/install-linux.sh",
    "update:language-profiles": "python3 scripts/update-language-profiles.py",
    "check:language-profiles": "python3 scripts/update-language-profiles.py --check"
  },
  "dependencies": {
    "@parcel/watcher": "^2.6.0",
    "@sanity/diff-match-patch": "^3.2.0",
    "@vscode/ripgrep": "^1.18.0",
    "@web-git-graph/node": "1.0.7",
    "@web-git-graph/protocol": "1.0.7",
    "@web-git-graph/web": "1.0.7",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-serialize": "0.14.0",
    "@xterm/headless": "6.0.0",
    "@xterm/xterm": "6.0.0",
    "crossnote": "0.9.35",
    "dexie": "3.2.7",
    "dompurify": "3.4.15",
    "electron-chrome-extensions": "4.9.0",
    "electron-chrome-web-store": "0.13.0",
    "htmlparser2": "9.1.0",
    "jsonc-parser": "^3.3.1",
    "monaco-editor": "0.56.0",
    "node-pty": "^1.1.0",
    "pdfjs-dist": "^6.3.289",
    "pyright": "1.1.414",
    "quick-score": "0.2.0",
    "sanitize-html": "^2.18.0",
    "simple-icons": "9.21.0",
    "turndown": "^7.2.4",
    "turndown-plugin-gfm": "^1.0.2",
    "vscode-jsonrpc": "9.0.1",
    "vscode-languageserver-protocol": "3.18.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@sveltejs/vite-plugin-svelte": "^6.2.4",
    "@types/node": "^22.0.0",
    "@types/sanitize-html": "^2.16.2",
    "@types/turndown": "^5.0.6",
    "concurrently": "^9.0.0",
    "cross-env": "^10.0.0",
    "electron": "44.7.2",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.25.0",
    "svelte": "^5.57.0",
    "svelte-check": "^4.7.6",
    "typescript": "^5.9.0",
    "vite": "^7.0.0",
    "vitest": "^3.0.0",
    "wait-on": "^8.0.0"
  },
  "build": {
    "appId": "app.setdown.desktop",
    "productName": "Setdown",
    "artifactName": "Setdown-${version}-${os}-${arch}.${ext}",
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "dist-electron/kernel-bridge.py",
      "node_modules/node-pty/**/*",
      "node_modules/pyright/**/*",
      "dist-electron/ublock/**/*"
    ],
    "directories": {
      "output": "release"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb",
        "rpm"
      ],
      "maintainer": "Setdown Contributors <yabsed@snu.ac.kr>",
      "category": "Office",
      "executableName": "setdown",
      "icon": "build/icon.png"
    },
    "deb": {
      "packageName": "setdown"
    },
    "rpm": {
      "packageName": "setdown"
    },
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true
    },
    "fileAssociations": [
      {
        "ext": [
          "md",
          "markdown",
          "mdown",
          "mkdn",
          "mkd",
          "rmd",
          "qmd",
          "mdx"
        ],
        "name": "Markdown document",
        "description": "Markdown document",
        "role": "Editor",
        "mimeType": "text/markdown"
      },
      {
        "ext": [
          "pdf"
        ],
        "name": "PDF document",
        "description": "PDF document",
        "role": "Viewer",
        "mimeType": "application/pdf"
      },
      {
        "ext": [
          "txt"
        ],
        "name": "Plain text",
        "description": "Plain text document",
        "role": "Editor",
        "mimeType": "text/plain"
      },
      {
        "ext": [
          "png",
          "jpg",
          "jpeg",
          "webp",
          "gif",
          "avif",
          "svg"
        ],
        "name": "Image",
        "description": "Image",
        "role": "Viewer"
      },
      {
        "ext": [
          "mp4",
          "webm"
        ],
        "name": "Video",
        "description": "Video",
        "role": "Viewer"
      }
    ]
  }
}
